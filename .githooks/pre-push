#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ -z "$remote" || -z "$url" ]]; then
  exit 0
fi

while read -r _ local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  git fetch "$remote" main --quiet 2>/dev/null || true

  export COMMIT_LIMIT_TZ="Asia/Jakarta"
  export GIT_PUSH_TIP="$local_sha"

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    export GIT_BRANCH=""
    export GIT_PUSH_BASE=""
  else
    export GIT_BRANCH="$remote_sha"
    export GIT_PUSH_BASE="$remote_sha"
  fi

  unset PENDING_MAIN_COMMITS
  npm run --silent check:main-commit-limit
done
