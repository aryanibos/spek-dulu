#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ -z "$remote" || -z "$url" ]]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  if ! git fetch "$remote" main --quiet 2>/dev/null; then
    echo "Could not fetch latest main from ${remote}; aborting push." >&2
    exit 1
  fi

  remote_main="$(git rev-parse "${remote}/main")"

  if [[ "$local_sha" == "$remote_main" ]]; then
    continue
  fi

  export COMMIT_LIMIT_TZ="Asia/Jakarta"
  export GIT_PUSH_TIP="$local_sha"
  export GIT_BRANCH="$remote_main"
  export GIT_PUSH_BASE="$remote_main"

  unset PENDING_MAIN_COMMITS
  npm run --silent check:main-commit-limit
done
