#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ -z "$remote" || -z "$url" ]]; then
  exit 0
fi

while read -r _ local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  if ! git fetch "$remote" main --quiet; then
    echo "Gagal fetch $remote/main; tidak bisa verifikasi batas commit harian." >&2
    exit 1
  fi

  fresh_remote_sha="$(git rev-parse "$remote/main")"

  export COMMIT_LIMIT_TZ="Asia/Jakarta"
  export GIT_PUSH_TIP="$local_sha"

  if [[ "$fresh_remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    export GIT_BRANCH=""
    export GIT_PUSH_BASE=""
  else
    export GIT_BRANCH="$fresh_remote_sha"
    export GIT_PUSH_BASE="$fresh_remote_sha"
  fi

  unset PENDING_MAIN_COMMITS
  npm run --silent check:main-commit-limit
done
