#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ -z "$remote" || -z "$url" ]]; then
  exit 0
fi

while read -r _ local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  if ! git fetch "$remote" main --quiet; then
    echo "pre-push: gagal fetch ${remote}/main; push dibatalkan." >&2
    exit 1
  fi

  export COMMIT_LIMIT_TZ="Asia/Jakarta"
  export GIT_PUSH_TIP="$local_sha"

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    export GIT_BRANCH=""
    export GIT_PUSH_BASE=""
  else
    fresh_main="$(git rev-parse "${remote}/main")"
    export GIT_BRANCH="$fresh_main"
    export GIT_PUSH_BASE="$fresh_main"
  fi

  unset PENDING_MAIN_COMMITS
  npm run --silent check:main-commit-limit
done
