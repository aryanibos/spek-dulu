#!/usr/bin/env bash
set -euo pipefail

remote="${1:-}"
url="${2:-}"

if [[ -z "$remote" || -z "$url" ]]; then
  exit 0
fi

if ! git fetch "$remote" main >/dev/null 2>&1; then
  echo "Could not fetch latest main from ${remote}; refusing push without up-to-date limit check" >&2
  exit 1
fi

while read -r _ local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    pending="$(git rev-list --count "${local_sha}" 2>/dev/null)" || {
      echo "Could not count pending commits for new main branch push" >&2
      exit 1
    }
  else
    pending="$(git rev-list --count "${remote_sha}..${local_sha}" 2>/dev/null)" || {
      echo "Could not count pending commits for main push" >&2
      exit 1
    }
  fi

  export GIT_BRANCH="${remote}/main"
  export PENDING_MAIN_COMMITS="$pending"
  npm run --silent check:main-commit-limit
done
